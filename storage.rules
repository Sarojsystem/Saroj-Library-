rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() { return request.auth != null && request.auth.uid == "PASTE_ADMIN_USER_UID"; }
    match /pdfs/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.size < 20 * 1024 * 1024
                   && request.resource.contentType == "application/pdf";
    }
  }
}