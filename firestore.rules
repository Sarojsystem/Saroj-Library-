rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() { return request.auth != null && request.auth.uid == "PASTE_ADMIN_USER_UID"; }
    match /questions/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /pdfs/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}